// Codespaces / VS Code dev container.
//
// `uv`, not pip: scripts/jobs/_env.bat runs every scheduled job through
// `uv run`, so this must install the same way production does.
//
// Python 3.13 to match .venv on Tom's machine. requires-python is >=3.11 and
// the suite passes on both, but a container should mirror one environment.
//
// Note what this does NOT give you: the database. `vnstock_market.db` (~22 MB)
// and `models/saved/*.pkl` are gitignored, so a fresh container starts empty —
// the app runs and shows nothing. See README "Chạy trên máy mới".
{
  "name": "Trading — VN Sector Money-Flow",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/va-h/devcontainers-features/uv:1": { "version": "latest" }
  },
  "postCreateCommand": "uv sync --frozen && (cd frontend && npm ci)",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API (uvicorn)" },
    "5173": { "label": "Frontend (vite)" }
  }
}
