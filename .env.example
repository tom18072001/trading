# ============================================
# Trading Project — Environment Configuration
# Copy to .env and adjust. Every value below is optional; the default shown
# is what config.py falls back to.
#
# Regenerated 2026-08-22 from config.py (review finding P3-3). The previous
# version still pointed DATA_SOURCE at VCI, which has returned empty since
# mid-April, and was missing every variable added since March — a fresh clone
# could not be configured from it.
# ============================================

# ---------- Database ----------
# Relative paths resolve against the project root. Keep this on a LOCAL disk:
# SQLite WAL on a network mount is fragile (CLAUDE.md §18.4/18).
DATABASE_PATH=vnstock_market.db

# ---------- Data source ----------
# KBS is the working vnstock source. VCI restricted its free tier and returns
# empty {} from its GraphQL (thinh-vu/vnstock#172); TCBS is deprecated.
DATA_SOURCE=KBS
# START_DATE=2021-01-01
# END_DATE=                      # defaults to today

# ---------- vnstock rate limiting (utils/vnstock_gate.py) ----------
# KBS guest tier is ~20 requests/minute; 18 leaves headroom. Raise only with a
# community (60/min) or sponsor key.
VNSTOCK_MAX_PER_MIN=18
# How long a scheduled job waits for the cross-process lock before skipping.
VNSTOCK_LOCK_WAIT=420

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Require X-API-Key on every router. Default 0 so the local dashboard works
# out of the box. SET THIS TO 1 BEFORE EXPOSING THE API (ngrok, cloudflared,
# port-forward) — otherwise anyone with the URL can trigger universe rebuilds
# and burn the KBS quota. See CODE_REVIEW_2026-08-22.md P2-1.
API_REQUIRE_KEY=0
# Allow browser origins on the shared ngrok / trycloudflare domains.
API_ALLOW_TUNNEL_ORIGINS=1
API_WRITE_RATE_LIMIT=20/minute

# ---------- Rotation model ----------
# Forward-return horizon the ranker is trained against (CLAUDE.md §16.4).
ROTATION_TARGET_HORIZON_DAYS=20

# ---------- Live-signal safety rails (CLAUDE.md §16.9, §18.2/12, §18.4/20) ----------
# Max concurrent ACCUMULATE positions.
MAX_ACCUMULATE_SECTORS=4
# Sessions a stealth event may run without a breakout before the slot is freed.
ACCUMULATE_MAX_AGE_SESSIONS=30
# Global kill-switch: 1 suppresses every new ACCUMULATE/BUY (all become HOLD).
TRADING_HALT=0
# The VN cash market cannot short. Set to 0 to stop publishing SELL signals,
# which is what §18.2/12 calls for. Default 1 preserves existing behaviour.
ALLOW_SHORT_SIGNALS=1

# ---------- Stealth detector (analysis/stealth.py, CLAUDE.md §16.1) ----------
# NOTE: these defaults are LOOSER than §16.1 as written (which specifies bottom
# 40% and 5 sessions). See CODE_REVIEW_2026-08-22.md P1-1 — the doctrine and
# the code need to be reconciled.
STEALTH_RETURN_BOTTOM_FRAC=0.60
STEALTH_MIN_SESSIONS=3
# Drops stealth condition 5 when close_idx is synthetic. Should no longer be
# needed now that the scheduled pipeline writes close_idx (P0-2).
STEALTH_SYNTHETIC_CLOSE=0

# ---------- Picks universe ----------
# Minimum passing tickers before top-5 BUY/SELL picks are built even on a
# degraded snapshot.
UNIVERSE_PICKS_FLOOR=20

# ---------- Trader agent "Minh" (services/trader_agent.py) ----------
# "local" names the TRANSPORT (plain HTTP to an OpenAI-compatible
# /chat/completions), not where the model runs. This box points it at 9Router
# on :20128, which fronts hosted Claude models -- dashboard at
# http://localhost:20128/dashboard. LM Studio, llama.cpp and Ollama speak the
# same shape, so switching is one line.
#   glm    = Z.ai Anthropic-compatible endpoint (needs GLM_API_KEY)
#   claude = Claude Code subscription via claude_agent_sdk
AGENT_PROVIDER=local
LOCAL_BASE_URL=http://localhost:20128/v1
# Whatever your endpoint wants. Leave empty to send no Authorization header.
LOCAL_API_KEY=
# Must be offered by the endpoint -- GET {LOCAL_BASE_URL}/models lists them.
LOCAL_MODEL=claude-opus-5
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/anthropic
# AGENT_MODEL=                   # defaults per provider
AGENT_TIMEOUT_SEC=90
AGENT_MAX_BUYS=3
AGENT_MAX_AVOID=2
AGENT_MAX_BUY_CANDIDATES=6
AGENT_MAX_SELL_CANDIDATES=4
AGENT_NEWS_PER_CANDIDATE=2

# ---------- Daily email report (generate_secv5.py) ----------
# Gmail address + APP PASSWORD (not the account password).
# REPORT_EMAIL_FROM=you@gmail.com
# REPORT_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Comma-separated. Required to send mail — there is no built-in list, so an
# empty value writes the HTML/PDF and skips the email. Real addresses live in
# your local `.env`, which is gitignored; this file is public.
# REPORT_EMAIL_TO=first@example.com,second@example.com
REPORT_DASHBOARD_URL=http://localhost:5173/insight/daily
# Override the DB the report reads (defaults to DATABASE_PATH).
# SECV3_DB_PATH=
