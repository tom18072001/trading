# ============================================
# Trading Project — Environment Configuration
# Copy this to .env and customize
# ============================================

# Database
DATABASE_PATH=vnstock_market.db

# Data Source: VCI, TCBS, MSN
DATA_SOURCE=VCI

# Date range (default: 3 years)
# START_DATE=2023-03-29
# END_DATE=2026-03-29

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
